<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" 
          content="IE=edge">
    <meta name="viewport" 
          content="width=device-width, initial-scale=1.0">
    <title>Design Stopwatch using HTML CSS and JavaScript</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="container">
       <h1>Pawse</h1>

<div class="kitty-container">
    <video id="kittyVideo" muted loop>
        <source src="./kittyAnimation-Picsart-BackgroundRemover.webm" type="video/webm">
    </video>

    <img id="kittyPhoto" src="./IMG_1654.PNG" alt="Kitty">
</div>

<div id="time">
    <span class="digit" id="hr">00</span>
    <span class="colon">:</span>
    <span class="digit" id="min">00</span>
    <span class="colon">:</span>
    <span class="digit" id="sec">00</span>
</div>
        <div id="buttons">
            <button class="btn" id="start">Start</button>
<button class="btn" id="pause">Pause</button>
<button class="btn" id="stop">Stop</button>
        </div>
    </div>
    <script src="script.js"></script>
</body>
  
</html>
