@font-face {
    font-family: "Pixelify Sans";
    src: url("./fonts/PixelifySans-VariableFont_wght.ttf") format("truetype");
    font-weight: 50 300;
}

body {
    padding: 0;
    margin: 0;
}

.container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100vh;
    background-color: rgb(228, 163, 212);
}

h1 {
    color: rgb(226, 29, 184);
    text-align: center;
    font-size: 50px;
    font-family: "Pixelify Sans", sans-serif;
}

.digit {
    font-size: 150px;
    color: #fff;
    font-family:Verdana, Geneva, Tahoma, sans-serif;
}
.colon {
    font-size: 150px;
    color: #fff;
}

.txt {
    font-size: 30px;
    color: #b93d96;
    font-family: "Pixelify Sans", sans-serif;
}

#buttons {
    margin-top: 50px;
}

.btn {
    width: 100px;
    padding: 10px 15px;
    margin: 0px 20px;
    border-radius: 25px;
    cursor: pointer;
    font-size: 20px;
    transition: 0.5s;
    color: white;
    font-weight: 500;
}

#start {
    background-color: #c13c7a;
    font-family: "Pixelify Sans", sans-serif;
}

#pause {
    background-color: #c13c7a;
    font-family: "Pixelify Sans", sans-serif;
}

#stop {
    background-color: #c13c7a;
    font-family: "Pixelify Sans", sans-serif;
}
